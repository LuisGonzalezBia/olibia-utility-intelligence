@biaenergy:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_GITHUB_TOKEN}
engine-strict=true

# Ningun paquete ejecuta codigo al instalar. Es la via por la que se propagan
# los gusanos de npm (Shai-Hulud y sucesores): un postinstall que busca tokens
# en el disco y se republica solo. Ver README para el unico caso que lo pedia.
ignore-scripts=true

# Sin rangos: `npm i <pkg>` fija la version exacta, asi un parche comprometido
# no entra solo al actualizar.
save-exact=true
